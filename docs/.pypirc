[distutils]
index-servers =
    pypi-releases
    pypi-snapshots
[pypi-releases]
repository = https://nexus-sidev.meteo.fr/repository/pypi-releases-%project-name%/
username = <nom_utilisateur>
password = <mot_de_passe>
[pypi-snapshots]
repository = https://nexus-sidev.meteo.fr/repository/pypi-snapshots-%project-name%/
username = <nom_utilisateur>
password = <mot_de_passe>
